# Supabase Auth & API
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""       # anon/public key (safe for client)
SUPABASE_SERVICE_ROLE_KEY=""           # service_role key (server-only, keep secret!)

# Database (Supabase PostgreSQL with Connection Pooling)
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
# Transaction mode (port 6543) - Use for application queries (pooled, serverless-safe)
DATABASE_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-xx-xx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session mode (port 5432) - Use for migrations (direct connection)
DIRECT_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-xx-xx.pooler.supabase.com:5432/postgres"

# Timezone
TZ="Asia/Kolkata"

# Rate Limiting (Upstash Redis — optional, required in production)
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""
RATE_LIMIT_MAX=3                # Max submissions per window
RATE_LIMIT_WINDOW_MS=3600000    # 1 hour in milliseconds
